{
	"$schema": "../tmlanguage.json",
	"name": "Ferrum",
	"scopeName": "source.ferrum",
	"fileTypes": ["fe"],

	"patterns": [
		{ "include": "#comment" },
		{ "include": "#string" },
		{ "include": "#number" },
		{ "include": "#section_keywords" },
		{ "include": "#control_flow" },
		{ "include": "#hardware_commands" },
		{ "include": "#ownership_keywords" },
		{ "include": "#interface_types" },
		{ "include": "#qualifiers" },
		{ "include": "#type_names" },
		{ "include": "#builtin_functions" },
		{ "include": "#boolean_literals" },
		{ "include": "#pin_state_literals" },
		{ "include": "#operators" },
		{ "include": "#function_definition" },
		{ "include": "#device_definition" },
		{ "include": "#identifier" }
	],

	"repository": {

		"comment": {
			"name": "comment.line.double-dash.ferrum",
			"match": "--.*$"
		},

		"string": {
			"name": "string.quoted.double.ferrum",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.ferrum",
					"match": "\\\\[\"\\\\n]"
				}
			]
		},

		"number": {
			"patterns": [
				{
					"name": "constant.numeric.hex.ferrum",
					"match": "\\b0[xX][0-9a-fA-F]+\\b"
				},
				{
					"name": "constant.numeric.float.ferrum",
					"match": "\\b[0-9]+\\.[0-9]+\\b"
				},
				{
					"name": "constant.numeric.clock.ferrum",
					"match": "(?i)\\b[0-9]+MHZ\\b"
				},
				{
					"name": "constant.numeric.duration.ferrum",
					"match": "\\b[0-9]+(ms|s)\\b"
				},
				{
					"name": "constant.numeric.integer.ferrum",
					"match": "\\b[0-9]+\\b"
				}
			]
		},

		"section_keywords": {
			"patterns": [
				{
					"name": "keyword.other.section.ferrum",
					"match": "(?i)\\b(CONFIG|DEFINE|CREATE|DECLARE|FUNCTION|RUN)\\b"
				}
			]
		},

		"control_flow": {
			"patterns": [
				{
					"name": "keyword.control.ferrum",
					"match": "(?i)\\b(IF|ELSE|LOOP|FOR|IN|RANGE|EVERY|BREAK|CONTINUE|RETURN|CALL)\\b"
				}
			]
		},

		"hardware_commands": {
			"patterns": [
				{
					"name": "keyword.other.command.ferrum",
					"match": "(?i)\\b(TURN|SET|TOGGLE|READ_PERCENT|READ|DELAY|PRINT|ON|PIN|PULL|UP|DOWN|INIT|AS|CONSTANT)\\b"
				}
			]
		},

		"ownership_keywords": {
			"patterns": [
				{
					"name": "storage.modifier.ownership.ferrum",
					"match": "(?i)\\b(GIVE|LEND|BORROW)\\b"
				}
			]
		},

		"interface_types": {
			"patterns": [
				{
					"name": "support.type.interface.ferrum",
					"match": "(?i)\\b(ANALOG_INPUT|INPUT|OUTPUT|PWM|DISPLAY|PULSE)\\b"
				}
			]
		},

		"qualifiers": {
			"patterns": [
				{
					"name": "support.type.qualifier.ferrum",
					"match": "(?i)\\b(BRIGHTNESS|SPEED|ANGLE|RED|GREEN|BLUE|LCD|OLED|TRIGGER|ECHO|ENABLE)\\b"
				}
			]
		},

		"type_names": {
			"patterns": [
				{
					"name": "storage.type.ferrum",
					"match": "(?i)\\b(Integer|Decimal|Percentage|Boolean|String|Byte)\\b"
				}
			]
		},

		"builtin_functions": {
			"patterns": [
				{
					"name": "support.function.builtin.ferrum",
					"match": "(?i)\\b(abs|min|max|clamp|map|to_integer|to_decimal|to_percentage|to_string|length|includes|add|remove)\\b"
				}
			]
		},

		"boolean_literals": {
			"patterns": [
				{
					"name": "constant.language.boolean.ferrum",
					"match": "(?i)\\b(TRUE|FALSE)\\b"
				}
			]
		},

		"pin_state_literals": {
			"patterns": [
				{
					"name": "constant.language.pinstate.ferrum",
					"match": "(?i)\\b(HIGH|LOW)\\b"
				}
			]
		},

		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.logical.ferrum",
					"match": "(?i)\\b(AND|OR|NOT|IS NOT|IS)\\b"
				},
				{
					"name": "keyword.operator.comparison.ferrum",
					"match": "(>=|<=|==|!=|>|<)"
				},
				{
					"name": "keyword.operator.assignment.ferrum",
					"match": "(?<![=!<>])=(?!=)"
				},
				{
					"name": "keyword.operator.arithmetic.ferrum",
					"match": "[+\\-*/]"
				}
			]
		},

		"function_definition": {
			"comment": "Highlight function name after FUNCTION keyword",
			"match": "(?i)\\b(FUNCTION)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
			"captures": {
				"1": { "name": "keyword.other.section.ferrum" },
				"2": { "name": "entity.name.function.ferrum" }
			}
		},

		"device_definition": {
			"comment": "Highlight device type name after DEFINE",
			"match": "(?i)\\b(DEFINE)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
			"captures": {
				"1": { "name": "keyword.other.section.ferrum" },
				"2": { "name": "entity.name.type.ferrum" }
			}
		},

		"identifier": {
			"name": "variable.other.ferrum",
			"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
		}
	}
}
