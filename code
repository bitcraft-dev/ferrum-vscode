// ╔══ FILE: ferrum-vscode/monaco/ferrumLanguage.ts ══╗
//
// Register the Ferrum language in Monaco Editor.
//
// USAGE in Tauri+Vue:
//   import { registerFerrumLanguage } from './monaco/ferrumLanguage';
//   registerFerrumLanguage(monaco);
//
// The TextMate grammar is used via monaco-editor-textmate if you
// want full parity with VS Code highlighting.
// Alternatively, the Monarch grammar below provides good highlighting
// without the textmate adapter dependency — useful for lighter builds.

import type * as Monaco from 'monaco-editor';

export function registerFerrumLanguage(monaco: typeof Monaco): void {
    // ── Register language ID ──────────────────────────────────────
    monaco.languages.register({
        id:         'ferrum',
        extensions: ['.fe'],
        aliases:    ['Ferrum', 'ferrum'],
        mimetypes:  ['text/x-ferrum'],
    });

    // ── Monarch tokeniser (TextMate-free alternative) ─────────────
    // Produces the same token names as the TextMate grammar so the
    // same theme rules apply in both VS Code and Monaco.
    monaco.languages.setMonarchTokensProvider('ferrum', {
        // Ferrum is case-insensitive — we match lowercase and let
        // the Monarch `ignoreCase` flag handle the rest.
        ignoreCase: true,

        keywords_section: [
            'config', 'define', 'create', 'declare', 'function', 'run'
        ],
        keywords_control: [
            'if', 'else', 'loop', 'for', 'in', 'range', 'every',
            'break', 'continue', 'return', 'call'
        ],
        keywords_command: [
            'turn', 'set', 'toggle', 'read_percent', 'read',
            'delay', 'print', 'on', 'pin', 'pull', 'up', 'down',
            'init', 'as', 'constant'
        ],
        keywords_ownership: ['give', 'lend', 'borrow'],
        keywords_interface: [
            'analog_input', 'input', 'output', 'pwm', 'display', 'pulse'
        ],
        keywords_qualifier: [
            'brightness', 'speed', 'angle', 'red', 'green', 'blue',
            'lcd', 'oled', 'trigger', 'echo', 'enable'
        ],
        keywords_type: [
            'integer', 'decimal', 'percentage', 'boolean', 'string', 'byte'
        ],
        keywords_builtin: [
            'abs', 'min', 'max', 'clamp', 'map',
            'to_integer', 'to_decimal', 'to_percentage', 'to_string',
            'length', 'includes', 'add', 'remove'
        ],
        keywords_literal: ['true', 'false', 'high', 'low'],
        keywords_operator: ['and', 'or', 'not', 'is'],

        tokenizer: {
            root: [
                // Comments
                [/--.*$/, 'comment'],

                // Strings
                [/"/, { token: 'string.quote', next: '@string' }],

                // Numbers: hex, float, clock, duration, integer
                [/0[xX][0-9a-fA-F]+/, 'number.hex'],
                [/\d+\.\d+/, 'number.float'],
                [/\d+[Mm][Hh][Zz]/, 'number.clock'],
                [/\d+(ms|s)\b/, 'number.duration'],
                [/\d+/, 'number'],

                // Identifiers and keywords
                [/[A-Za-z_][A-Za-z0-9_]*/, {
                    cases: {
                        '@keywords_section':   'keyword.section',
                        '@keywords_control':   'keyword.control',
                        '@keywords_command':   'keyword.command',
                        '@keywords_ownership': 'keyword.ownership',
                        '@keywords_interface': 'type.interface',
                        '@keywords_qualifier': 'type.qualifier',
                        '@keywords_type':      'keyword.type',
                        '@keywords_builtin':   'support.function',
                        '@keywords_literal':   'constant.language',
                        '@keywords_operator':  'keyword.operator',
                        '@default':            'identifier',
                    }
                }],

                // Operators
                [/[><!]=?|==|!=/, 'operator'],
                [/[+\-*/]/, 'operator'],
                [/(?<![=!<>])=(?!=)/, 'operator.assignment'],

                // Punctuation
                [/[{}[\]()]/, 'delimiter'],
                [/[,:]/, 'delimiter'],
            ],

            string: [
                [/[^"\\]+/, 'string'],
                [/\\["\\\n]/, 'string.escape'],
                [/"/, { token: 'string.quote', next: '@pop' }],
            ],
        },
    } as Monaco.languages.IMonarchLanguage);

    // ── Language configuration ────────────────────────────────────
    monaco.languages.setLanguageConfiguration('ferrum', {
        comments:           { lineComment: '--' },
        brackets:           [['{','}'], ['[',']'], ['(',')']],
        autoClosingPairs:   [
            { open: '{',  close: '}' },
            { open: '[',  close: ']' },
            { open: '(',  close: ')' },
            { open: '"',  close: '"', notIn: ['string', 'comment'] },
        ],
        surroundingPairs:   [
            { open: '{', close: '}' },
            { open: '[', close: ']' },
            { open: '(', close: ')' },
            { open: '"', close: '"' },
        ],
        indentationRules: {
            increaseIndentPattern: /\{\s*$/,
            decreaseIndentPattern: /^\s*\}/,
        },
        wordPattern: /[A-Za-z_][A-Za-z0-9_]*/,
    });
}
