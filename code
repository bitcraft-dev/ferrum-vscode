// ╔══ FILE: ferrum-vscode/monaco/ferrumDiagnostics.ts ══╗
//
// Diagnostic bridge for Monaco Editor.
//
// The Ferrum compiler outputs diagnostics in the format:
//   [file:line:col] error[E007]: message
//   Suggestion: fix text
//
// This module parses that output and sets Monaco editor markers
// so errors appear as red squiggles inline.
//
// USAGE in Tauri+Vue:
//   Call applyFerrumDiagnostics(monaco, model, compilerOutput)
//   after receiving output from `ferrum check file.fe` via Tauri's
//   Command API (invoke / shell plugin).

import type * as Monaco from 'monaco-editor';

export interface FerrumDiagnostic {
    file:       string;
    line:       number;
    column:     number;
    severity:   'error' | 'warning';
    code:       string;
    message:    string;
    suggestion: string | null;
}

// ── Parse compiler output ─────────────────────────────────────────

const DIAG_PATTERN =
    /^\[([^:]+):(\d+):(\d+)\]\s+(error|warning)\[([A-Z]\d+)\]:\s+(.+)$/;
const SUGGESTION_PATTERN = /^\s+Suggestion:\s+(.+)$/;

export function parseFerrumOutput(output: string): FerrumDiagnostic[] {
    const lines = output.split('\n');
    const results: FerrumDiagnostic[] = [];
    let current: FerrumDiagnostic | null = null;

    for (const line of lines) {
        const diagMatch = DIAG_PATTERN.exec(line);
        if (diagMatch) {
            current = {
                file:       diagMatch[1],
                line:       parseInt(diagMatch[2], 10),
                column:     parseInt(diagMatch[3], 10),
                severity:   diagMatch[4] as 'error' | 'warning',
                code:       diagMatch[5],
                message:    diagMatch[6],
                suggestion: null,
            };
            results.push(current);
            continue;
        }

        const suggMatch = SUGGESTION_PATTERN.exec(line);
        if (suggMatch && current) {
            current.suggestion = suggMatch[1];
        }
    }

    return results;
}

// ── Apply diagnostics to Monaco model ────────────────────────────

export function applyFerrumDiagnostics(
    monaco:  typeof Monaco,
    model:   Monaco.editor.ITextModel,
    output:  string,
): void {
    const diagnostics = parseFerrumOutput(output);

    const markers: Monaco.editor.IMarkerData[] = diagnostics.map(d => ({
        severity: d.severity === 'error'
            ? monaco.MarkerSeverity.Error
            : monaco.MarkerSeverity.Warning,
        startLineNumber: d.line,
        startColumn:     d.column,
        endLineNumber:   d.line,
        endColumn:       d.column + 1,
        message:         d.suggestion
            ? `${d.message}\n💡 ${d.suggestion}`
            : d.message,
        code:            d.code,
        source:          'ferrum',
    }));

    monaco.editor.setModelMarkers(model, 'ferrum', markers);
}

// ── Clear all markers ─────────────────────────────────────────────

export function clearFerrumDiagnostics(
    monaco: typeof Monaco,
    model:  Monaco.editor.ITextModel,
): void {
    monaco.editor.setModelMarkers(model, 'ferrum', []);
}

// ── Tests (host-side, no Monaco dependency) ──────────────────────

if (typeof describe !== 'undefined') {
    describe('parseFerrumOutput', () => {
        it('parses an error line', () => {
            const output = '[test.fe:12:5] error[E007]: Type mismatch: expected Integer, found Decimal.\n  Suggestion: Use to_integer to convert.';
            const diags  = parseFerrumOutput(output);
            console.assert(diags.length === 1);
            console.assert(diags[0].line === 12);
            console.assert(diags[0].severity === 'error');
            console.assert(diags[0].code === 'E007');
            console.assert(diags[0].suggestion !== null);
        });

        it('parses a warning line', () => {
            const output = '[test.fe:3:1] warning[W001]: \'count\' is declared but never used.';
            const diags  = parseFerrumOutput(output);
            console.assert(diags[0].severity === 'warning');
            console.assert(diags[0].code === 'W001');
        });

        it('returns empty for clean output', () => {
            const diags = parseFerrumOutput('✓ test.fe — no errors\n');
            console.assert(diags.length === 0);
        });
    });
}
