// ================================================================
// FERRUM — VS CODE EXTENSION + MONACO EDITOR INTEGRATION
// ferrum_vscode_extension
//
// Every file is clearly delimited by:
//
//   ╔══ FILE: path/to/file ══╗
//   ...
//   ╚══ END FILE ══╝
//
// Contents:
//   ── VS CODE EXTENSION ───────────────────────────────────────
//   1.  package.json                    — extension manifest
//   2.  syntaxes/ferrum.tmLanguage.json — TextMate grammar
//   3.  language-configuration.json    — bracket/comment config
//   4.  themes/ferrum-dark.json        — colour theme
//   5.  snippets/ferrum.json           — code snippets
//   6.  src/extension.ts               — extension entry point
//   7.  src/ferrumLsp.ts               — LSP client wiring
//   8.  .vscode/launch.json            — debug config
//   9.  tsconfig.json
//  10.  README.md
//
//   ── MONACO EDITOR INTEGRATION ───────────────────────────────
//  11.  monaco/ferrumLanguage.ts       — register language + grammar
//  12.  monaco/ferrumTheme.ts          — colour theme tokens
//  13.  monaco/ferrumCompletion.ts     — completion item provider
//  14.  monaco/ferrumDiagnostics.ts    — error marker bridge
//  15.  monaco/index.ts                — single import entry point
//
// NOTE ON REUSE
//   The TextMate grammar (file 2) is used verbatim by both VS Code
//   and Monaco via the `monaco-editor-textmate` adapter.
//   The theme token colours (file 12) are derived from file 4.
//   The completion item list (file 13) mirrors the snippets (file 5).
//   Everything is designed so that Tauri+Vue can host Monaco with
//   full feature parity to the VS Code extension.
// ================================================================


// ╔══ FILE: ferrum-vscode/package.json ══╗
{
  "name": "ferrum-lang",
  "displayName": "Ferrum",
  "description": "Language support for the Ferrum embedded DSL (.fe files)",
  "version": "0.1.0",
  "publisher": "ferrum-lang",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "icon": "images/ferrum-icon.png",
  "keywords": ["ferrum", "embedded", "microbit", "rp2040", "iot", "education"],
  "repository": { "type": "git", "url": "https://github.com/ferrum-lang/ferrum-vscode" },

  "activationEvents": [],

  "main": "./out/extension.js",

  "contributes": {
    "languages": [
      {
        "id": "ferrum",
        "aliases": ["Ferrum", "ferrum"],
        "extensions": [".fe"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/ferrum-icon.png",
          "dark":  "./images/ferrum-icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "ferrum",
        "scopeName": "source.ferrum",
        "path": "./syntaxes/ferrum.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Ferrum Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/ferrum-dark.json"
      }
    ],
    "snippets": [
      {
        "language": "ferrum",
        "path": "./snippets/ferrum.json"
      }
    ],
    "commands": [
      {
        "command": "ferrum.compile",
        "title": "Ferrum: Compile",
        "icon": "$(play)"
      },
      {
        "command": "ferrum.check",
        "title": "Ferrum: Check (type-check only)"
      },
      {
        "command": "ferrum.showTokens",
        "title": "Ferrum: Show Token Stream (debug)"
      },
      {
        "command": "ferrum.showAst",
        "title": "Ferrum: Show AST (debug)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ferrum.compile",
          "when": "resourceExtname == .fe",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Ferrum",
      "properties": {
        "ferrum.compilerPath": {
          "type": "string",
          "default": "ferrum",
          "description": "Path to the ferrum compiler binary"
        },
        "ferrum.enableLsp": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Ferrum language server for inline diagnostics"
        },
        "ferrum.autoCheckOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run ferrum check automatically on file save"
        }
      }
    },
    "problemMatchers": [
      {
        "name": "ferrum",
        "owner": "ferrum",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": [
          {
            "regexp": "^\\[(.*?):(\\d+):(\\d+)\\]\\s+(error|warning)\\[([A-Z]\\d+)\\]:\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "code": 5,
            "message": 6
          },
          {
            "regexp": "^\\s+Suggestion:\\s+(.*)$",
            "message": 1,
            "loop": true
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "ferrum",
        "required": ["task"],
        "properties": {
          "task": {
            "type": "string",
            "enum": ["compile", "check"]
          }
        }
      }
    ]
  },

  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },

  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0"
  },

  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
// ╚══ END FILE ══╝


// ╔══ FILE: ferrum-vscode/syntaxes/ferrum.tmLanguage.json ══╗
//
// TextMate grammar for Ferrum (.fe files).
//
// SCOPE NAMING CONVENTIONS (TextMate standard)
//   keyword.control.*       — control flow: IF, ELSE, LOOP, FOR, etc.
//   keyword.other.*         — other keywords: DEFINE, CREATE, DECLARE, etc.
//   storage.type.*          — type names: Integer, Decimal, etc.
//   storage.modifier.*      — ownership keywords: GIVE, LEND, BORROW
//   entity.name.function.*  — function names in definitions
//   entity.name.type.*      — device type names in definitions
//   variable.other.*        — identifiers
//   constant.numeric.*      — numeric literals
//   string.quoted.*         — string literals
//   comment.line.*          — comments
//   support.function.*      — built-in functions
//   keyword.operator.*      — operators
//
// CASE INSENSITIVITY
//   Ferrum keywords are case-insensitive. TextMate regex uses (?i)
//   inline flags to match any capitalisation without duplicating rules.
{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ferrum",
  "scopeName": "source.ferrum",
  "fileTypes": ["fe"],

  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#section_keywords" },
    { "include": "#control_flow" },
    { "include": "#hardware_commands" },
    { "include": "#ownership_keywords" },
    { "include": "#interface_types" },
    { "include": "#qualifiers" },
    { "include": "#type_names" },
    { "include": "#builtin_functions" },
    { "include": "#boolean_literals" },
    { "include": "#pin_state_literals" },
    { "include": "#operators" },
    { "include": "#function_definition" },
    { "include": "#device_definition" },
    { "include": "#identifier" }
  ],

  "repository": {

    "comment": {
      "name": "comment.line.double-dash.ferrum",
      "match": "--.*$"
    },

    "string": {
      "name": "string.quoted.double.ferrum",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.ferrum",
          "match": "\\\\[\"\\\\n]"
        }
      ]
    },

    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.ferrum",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.float.ferrum",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.clock.ferrum",
          "match": "(?i)\\b[0-9]+MHZ\\b"
        },
        {
          "name": "constant.numeric.duration.ferrum",
          "match": "\\b[0-9]+(ms|s)\\b"
        },
        {
          "name": "constant.numeric.integer.ferrum",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },

    "section_keywords": {
      "patterns": [
        {
          "name": "keyword.other.section.ferrum",
          "match": "(?i)\\b(CONFIG|DEFINE|CREATE|DECLARE|FUNCTION|RUN)\\b"
        }
      ]
    },

    "control_flow": {
      "patterns": [
        {
          "name": "keyword.control.ferrum",
          "match": "(?i)\\b(IF|ELSE|LOOP|FOR|IN|RANGE|EVERY|BREAK|CONTINUE|RETURN|CALL)\\b"
        }
      ]
    },

    "hardware_commands": {
      "patterns": [
        {
          "name": "keyword.other.command.ferrum",
          "match": "(?i)\\b(TURN|SET|TOGGLE|READ_PERCENT|READ|DELAY|PRINT|ON|PIN|PULL|UP|DOWN|INIT|AS|CONSTANT)\\b"
        }
      ]
    },

    "ownership_keywords": {
      "patterns": [
        {
          "name": "storage.modifier.ownership.ferrum",
          "match": "(?i)\\b(GIVE|LEND|BORROW)\\b"
        }
      ]
    },

    "interface_types": {
      "patterns": [
        {
          "name": "support.type.interface.ferrum",
          "match": "(?i)\\b(ANALOG_INPUT|INPUT|OUTPUT|PWM|DISPLAY|PULSE)\\b"
        }
      ]
    },

    "qualifiers": {
      "patterns": [
        {
          "name": "support.type.qualifier.ferrum",
          "match": "(?i)\\b(BRIGHTNESS|SPEED|ANGLE|RED|GREEN|BLUE|LCD|OLED|TRIGGER|ECHO|ENABLE)\\b"
        }
      ]
    },

    "type_names": {
      "patterns": [
        {
          "name": "storage.type.ferrum",
          "match": "(?i)\\b(Integer|Decimal|Percentage|Boolean|String|Byte)\\b"
        }
      ]
    },

    "builtin_functions": {
      "patterns": [
        {
          "name": "support.function.builtin.ferrum",
          "match": "(?i)\\b(abs|min|max|clamp|map|to_integer|to_decimal|to_percentage|to_string|length|includes|add|remove)\\b"
        }
      ]
    },

    "boolean_literals": {
      "patterns": [
        {
          "name": "constant.language.boolean.ferrum",
          "match": "(?i)\\b(TRUE|FALSE)\\b"
        }
      ]
    },

    "pin_state_literals": {
      "patterns": [
        {
          "name": "constant.language.pinstate.ferrum",
          "match": "(?i)\\b(HIGH|LOW)\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.ferrum",
          "match": "(?i)\\b(AND|OR|NOT|IS NOT|IS)\\b"
        },
        {
          "name": "keyword.operator.comparison.ferrum",
          "match": "(>=|<=|==|!=|>|<)"
        },
        {
          "name": "keyword.operator.assignment.ferrum",
          "match": "(?<![=!<>])=(?!=)"
        },
        {
          "name": "keyword.operator.arithmetic.ferrum",
          "match": "[+\\-*/]"
        }
      ]
    },

    "function_definition": {
      "comment": "Highlight function name after FUNCTION keyword",
      "match": "(?i)\\b(FUNCTION)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.other.section.ferrum" },
        "2": { "name": "entity.name.function.ferrum" }
      }
    },

    "device_definition": {
      "comment": "Highlight device type name after DEFINE",
      "match": "(?i)\\b(DEFINE)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.other.section.ferrum" },
        "2": { "name": "entity.name.type.ferrum" }
      }
    },

    "identifier": {
      "name": "variable.other.ferrum",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    }
  }
}
// ╚══ END FILE ══╝


// ╔══ FILE: ferrum-vscode/language-configuration.json ══╗
{
  "comments": {
    "lineComment": "--"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{",  "close": "}" },
    { "open": "[",  "close": "]" },
    { "open": "(",  "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{",  "}"],
    ["[",  "]"],
    ["(",  ")"],
    ["\"", "\""]
  ],
  "onEnterRules": [
    {
      "beforeText": "\\{\\s*$",
      "action": {
        "indent": "indent"
      }
    }
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*",
  "indentationRules": {
    "increaseIndentPattern": "\\{\\s*$",
    "decreaseIndentPattern": "^\\s*\\}"
  }
}
// ╚══ END FILE ══╝


// ╔══ FILE: ferrum-vscode/themes/ferrum-dark.json ══╗
//
// Ferrum Dark — a theme tuned for embedded/hardware code.
// Iron and amber palette: dark background, warm keyword colours,
// distinct colours for hardware concepts vs data flow concepts.
{
  "name": "Ferrum Dark",
  "type": "dark",
  "colors": {
    "editor.background":              "#1a1a1e",
    "editor.foreground":              "#d4cfc8",
    "editor.lineHighlightBackground": "#252530",
    "editor.selectionBackground":     "#3a3a50",
    "editorCursor.foreground":        "#e8a050",
    "editorLineNumber.foreground":    "#4a4a5a",
    "editorLineNumber.activeForeground": "#888890"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": "comment",
      "settings": { "foreground": "#5a6a5a", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": "string",
      "settings": { "foreground": "#a8c878" }
    },
    {
      "name": "Escape sequences",
      "scope": "constant.character.escape",
      "settings": { "foreground": "#c8e898" }
    },
    {
      "name": "Numbers",
      "scope": "constant.numeric",
      "settings": { "foreground": "#d4a860" }
    },
    {
      "name": "Clock and duration literals",
      "scope": [
        "constant.numeric.clock.ferrum",
        "constant.numeric.duration.ferrum"
      ],
      "settings": { "foreground": "#e8b870", "fontStyle": "bold" }
    },
    {
      "name": "Boolean and pin-state literals",
      "scope": [
        "constant.language.boolean.ferrum",
        "constant.language.pinstate.ferrum"
      ],
      "settings": { "foreground": "#e8c860", "fontStyle": "bold" }
    },
    {
      "name": "Section keywords (CONFIG DEFINE CREATE DECLARE FUNCTION RUN)",
      "scope": "keyword.other.section.ferrum",
      "settings": { "foreground": "#e87840", "fontStyle": "bold" }
    },
    {
      "name": "Control flow (IF ELSE LOOP FOR EVERY RETURN CALL etc.)",
      "scope": "keyword.control.ferrum",
      "settings": { "foreground": "#c86880" }
    },
    {
      "name": "Hardware commands (TURN SET READ DELAY PRINT etc.)",
      "scope": "keyword.other.command.ferrum",
      "settings": { "foreground": "#78b8d8" }
    },
    {
      "name": "Ownership keywords (GIVE LEND BORROW)",
      "scope": "storage.modifier.ownership.ferrum",
      "settings": { "foreground": "#d878c8", "fontStyle": "bold italic" }
    },
    {
      "name": "Interface types (INPUT OUTPUT PWM etc.)",
      "scope": "support.type.interface.ferrum",
      "settings": { "foreground": "#70c8a8" }
    },
    {
      "name": "Qualifiers (BRIGHTNESS SPEED ANGLE etc.)",
      "scope": "support.type.qualifier.ferrum",
      "settings": { "foreground": "#60b898" }
    },
    {
      "name": "Data type names (Integer Decimal Boolean etc.)",
      "scope": "storage.type.ferrum",
      "settings": { "foreground": "#88b8e8" }
    },
    {
      "name": "Built-in functions (abs clamp map etc.)",
      "scope": "support.function.builtin.ferrum",
      "settings": { "foreground": "#c8a8e8" }
    },
    {
      "name": "Logical operators (AND OR NOT IS)",
      "scope": "keyword.operator.logical.ferrum",
      "settings": { "foreground": "#c86880" }
    },
    {
      "name": "Comparison and arithmetic operators",
      "scope": [
        "keyword.operator.comparison.ferrum",
        "keyword.operator.arithmetic.ferrum",
        "keyword.operator.assignment.ferrum"
      ],
      "settings": { "foreground": "#d0c8b0" }
    },
    {
      "name": "Function names",
      "scope": "entity.name.function.ferrum",
      "settings": { "foreground": "#f0d080", "fontStyle": "bold" }
    },
    {
      "name": "Device type names",
      "scope": "entity.name.type.ferrum",
      "settings": { "foreground": "#80d8c0", "fontStyle": "bold" }
    },
    {
      "name": "Identifiers",
      "scope": "variable.other.ferrum",
      "settings": { "foreground": "#d4cfc8" }
    }
  ]
}
// ╚══ END FILE ══╝


// ╔══ FILE: ferrum-vscode/snippets/ferrum.json ══╗
{
  "Minimal program skeleton": {
    "prefix": "ferrum",
    "body": [
      "CONFIG {",
      "    TARGET = \"${1|microbit_v2,rp2040|}\"",
      "    DEBUG  = TRUE",
      "}",
      "",
      "DEFINE ${2:Led} AS OUTPUT",
      "",
      "CREATE ${2:Led} ${3:led} ON PIN ${4:13}",
      "",
      "RUN {",
      "    LOOP {",
      "        $0",
      "    }",
      "}"
    ],
    "description": "Minimal Ferrum program with CONFIG, DEFINE, CREATE, RUN"
  },

  "CONFIG block": {
    "prefix": "config",
    "body": [
      "CONFIG {",
      "    TARGET      = \"${1|microbit_v2,rp2040|}\"",
      "    DEBUG       = ${2|TRUE,FALSE|}",
      "    DEBOUNCE_MS = ${3:50}",
      "}"
    ],
    "description": "CONFIG section"
  },

  "DEFINE simple device": {
    "prefix": "define",
    "body": [
      "DEFINE ${1:DeviceName} AS ${2|INPUT,OUTPUT,ANALOG_INPUT,PWM,DISPLAY,PULSE|}"
    ],
    "description": "DEFINE a simple device type"
  },

  "DEFINE composite device": {
    "prefix": "definec",
    "body": [
      "DEFINE ${1:DeviceName} AS {",
      "    ${2:OUTPUT},",
      "    ${3:PWM BRIGHTNESS}",
      "}"
    ],
    "description": "DEFINE a composite device type"
  },

  "CREATE single pin": {
    "prefix": "create",
    "body": [
      "CREATE ${1:DeviceType} ${2:instance} ON PIN ${3:13}"
    ],
    "description": "CREATE a device on a single pin"
  },

  "CREATE composite with INIT": {
    "prefix": "createc",
    "body": [
      "CREATE ${1:DeviceType} ${2:instance} ON {",
      "    ${3:output}: PIN ${4:3},",
      "    ${5:brightness}: PIN ${6:4}",
      "} INIT {",
      "    ${3:output}: ${7|LOW,HIGH|},",
      "    ${5:brightness}: ${8:0.0}",
      "}"
    ],
    "description": "CREATE a composite device with named pins and INIT"
  },

  "DECLARE variable": {
    "prefix": "decl",
    "body": [
      "DECLARE ${1|Integer,Decimal,Percentage,Boolean,String,Byte|} ${2:name} INIT ${3:0}"
    ],
    "description": "DECLARE a variable"
  },

  "DECLARE constant": {
    "prefix": "const",
    "body": [
      "DECLARE CONSTANT ${1|Integer,Decimal,Percentage,Boolean,String,Byte|} ${2:NAME} = ${3:0}"
    ],
    "description": "DECLARE a constant"
  },

  "FUNCTION with data params": {
    "prefix": "fn",
    "body": [
      "FUNCTION ${1:name} ${2:Integer}: ${3:param} {",
      "    $0",
      "}"
    ],
    "description": "FUNCTION definition with data parameters"
  },

  "FUNCTION with device BORROW": {
    "prefix": "fnborrow",
    "body": [
      "FUNCTION ${1:name} BORROW ${2:DeviceType}: ${3:device} {",
      "    $0",
      "}"
    ],
    "description": "FUNCTION definition that BORROWs a device"
  },

  "FUNCTION with device GIVE": {
    "prefix": "fngive",
    "body": [
      "FUNCTION ${1:name} GIVE ${2:DeviceType}: ${3:device} {",
      "    $0",
      "}"
    ],
    "description": "FUNCTION definition that takes GIVE ownership"
  },

  "FUNCTION with RETURN": {
    "prefix": "fnret",
    "body": [
      "FUNCTION ${1:name} ${2:Integer}: ${3:param} {",
      "    $0",
      "    RETURN ${4:value}",
      "}"
    ],
    "description": "FUNCTION definition with RETURN"
  },

  "RUN LOOP": {
    "prefix": "run",
    "body": [
      "RUN {",
      "    LOOP {",
      "        $0",
      "    }",
      "}"
    ],
    "description": "RUN section with LOOP"
  },

  "EVERY block": {
    "prefix": "every",
    "body": [
      "EVERY ${1:1000}ms {",
      "    $0",
      "}"
    ],
    "description": "EVERY scheduled block"
  },

  "IF block": {
    "prefix": "if",
    "body": [
      "IF ${1:condition} {",
      "    $0",
      "}"
    ],
    "description": "IF statement"
  },

  "IF ELSE block": {
    "prefix": "ifelse",
    "body": [
      "IF ${1:condition} {",
      "    $0",
      "} ELSE {",
      "    $2",
      "}"
    ],
    "description": "IF/ELSE statement"
  },

  "FOR RANGE loop": {
    "prefix": "for",
    "body": [
      "FOR ${1:i} IN RANGE ${2:0}, ${3:9} {",
      "    $0",
      "}"
    ],
    "description": "FOR loop over a range"
  },

  "FOR array loop": {
    "prefix": "fora",
    "body": [
      "FOR ${1:item} IN ${2:array} {",
      "    $0",
      "}"
    ],
    "description": "FOR loop over an array"
  },

  "TURN HIGH": {
    "prefix": "high",
    "body": ["TURN ${1:device} HIGH"],
    "description": "TURN device HIGH"
  },

  "TURN LOW": {
    "prefix": "low",
    "body": ["TURN ${1:device} LOW"],
    "description": "TURN device LOW"
  },

  "SET with qualifier": {
    "prefix": "set",
    "body": [
      "SET ${1:device} ${2|BRIGHTNESS,SPEED,ANGLE,RED,GREEN,BLUE|} ${3:0.5}"
    ],
    "description": "SET device PWM qualifier"
  },

  "READ_PERCENT": {
    "prefix": "read",
    "body": ["READ_PERCENT ${1:sensor}"],
    "description": "Read analog sensor as percentage"
  },

  "DELAY ms": {
    "prefix": "delay",
